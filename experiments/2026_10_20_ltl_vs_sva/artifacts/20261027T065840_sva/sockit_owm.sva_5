assert property (@(posedge clk) disable iff (rst) bus_irq == (irq_ena & irq_sts));
assert property (@(posedge clk) disable iff (rst) owr_p == owr_pwr);
assert property (@(posedge clk) disable iff (rst) owr_e == (owr_oen << owr_sel));
assert property (@(posedge clk) disable iff (rst) req_ovd == (bus_wen && (bus_adr[0] == 1'b0) && bus_wdt[2]));
assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts == (bus_wen && (bus_adr[0] == 1'b0)));
assert property (@(posedge clk) disable iff (rst) bus_ren_ctl_sts == (bus_ren && (bus_adr[0] == 1'b0)));
assert property (@(posedge clk) disable iff (rst) (bus_adr[0] == 1'b0) |-> bus_rdt[7:0] == {irq_ena, irq_sts, 1'b0, owr_pwr[0], owr_cyc, owr_ovd, owr_rst, owr_dat});
assert property (@(posedge clk) disable iff (rst) (bus_adr[0] == 1'b0) |-> bus_rdt[5] == 1'b0);
assert property (@(posedge clk) disable iff (rst) (bus_adr[0] == 1'b0) |-> bus_rdt[31:8] == 24'h0);
assert property (@(posedge clk) disable iff (rst) (bus_adr[0] == 1'b1) |-> bus_rdt == {cdr_o, cdr_n});
assert property (@(posedge clk) disable iff (rst) pls == (div == (owr_ovd ? cdr_o : cdr_n)));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b1) |=> cdr_n == $past(bus_wdt[15:0]));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b1) |=> cdr_o == $past(bus_wdt[31:16]));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b1) |=> $stable(cdr_n));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b1) |=> $stable(cdr_o));
assert property (@(posedge clk) disable iff (rst) bus_wen |=> div == '0);
assert property (@(posedge clk) disable iff (rst) (!bus_wen && pls) |=> div == '0);
assert property (@(posedge clk) disable iff (rst) (!bus_wen && !pls) |=> div == $past(div + owr_cyc));
assert property (@(posedge clk) disable iff (rst) (!bus_wen && !pls && !owr_cyc) |=> $stable(div));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_pwr == $past(bus_wdt[4]));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b0) |=> $stable(owr_pwr));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> irq_ena == $past(bus_wdt[7]));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b0) |=> $stable(irq_ena));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> !irq_sts);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && cnt == '0) |=> irq_sts);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !(pls && cnt == '0) && bus_ren && bus_adr[0] == 1'b0) |=> !irq_sts);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !(pls && cnt == '0) && !(bus_ren && bus_adr[0] == 1'b0)) |=> $stable(irq_sts));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_ovd == $past(bus_wdt[2]));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b0) |=> $stable(owr_ovd));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_rst == $past(bus_wdt[1]));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b0) |=> $stable(owr_rst));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_dat == $past(bus_wdt[0]));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && cnt == '0) |=> owr_dat == $past(owr_smp));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !(pls && cnt == '0)) |=> $stable(owr_dat));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_cyc == $past(bus_wdt[3] & ~&bus_wdt[2:0]));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0 && (&bus_wdt[2:0])) |=> !owr_cyc);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && cnt == '0) |=> !owr_cyc);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !(pls && cnt == '0)) |=> $stable(owr_cyc));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> cnt == $past(TDW'((&bus_wdt[1:0] ? t_idl : bus_wdt[1] ? t_rst : t_bit) - 1'b1)));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls) |=> cnt == $past(TDW'(cnt - 1'b1)));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !pls) |=> $stable(cnt));
assert property (@(posedge clk) disable iff (rst) (pls && owr_rst && cnt == t_rstp) |=> owr_smp == $past(owr_iln));
assert property (@(posedge clk) disable iff (rst) (pls && !owr_rst && cnt == t_bits) |=> owr_smp == $past(owr_iln));
assert property (@(posedge clk) disable iff (rst) !(pls && ((owr_rst && cnt == t_rstp) || (!owr_rst && cnt == t_bits))) |=> $stable(owr_smp));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_oen == $past(~&bus_wdt[1:0]));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && owr_rst && cnt == t_rsth) |=> !owr_oen);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && owr_dat && cnt == t_dat1) |=> !owr_oen);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && cnt == t_dat0) |=> !owr_oen);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !pls) |=> $stable(owr_oen));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0)) |=> !owr_oen || $past(owr_oen));
assert property (@(posedge clk) $past(rst) |-> (div == '0 && cnt == '0 && !owr_cyc && !owr_oen && !owr_dat && !owr_rst && !owr_ovd && !irq_ena && !irq_sts && owr_pwr == '0));
assert property (@(posedge clk) $past(rst) |-> (cdr_n == CDR_N && cdr_o == CDR_O));
assert property (@(posedge clk) $past(rst) |-> !bus_irq);
