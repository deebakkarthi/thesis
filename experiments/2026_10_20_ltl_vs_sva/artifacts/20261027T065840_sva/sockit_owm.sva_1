a_rst_div: assert property (@(posedge clk) rst |-> div == '0);
a_rst_cnt: assert property (@(posedge clk) rst |-> cnt == '0);
a_rst_owr_cyc: assert property (@(posedge clk) rst |-> !owr_cyc);
a_rst_owr_ovd: assert property (@(posedge clk) rst |-> !owr_ovd);
a_rst_owr_rst: assert property (@(posedge clk) rst |-> !owr_rst);
a_rst_owr_dat: assert property (@(posedge clk) rst |-> !owr_dat);
a_rst_owr_oen: assert property (@(posedge clk) rst |-> !owr_oen);
a_rst_owr_pwr: assert property (@(posedge clk) rst |-> owr_pwr == '0);
a_rst_irq_ena: assert property (@(posedge clk) rst |-> !irq_ena);
a_rst_irq_sts: assert property (@(posedge clk) rst |-> !irq_sts);
a_rst_cdr_n: assert property (@(posedge clk) rst |-> cdr_n == CDR_N);
a_rst_cdr_o: assert property (@(posedge clk) rst |-> cdr_o == CDR_O);
a_bus_irq_def: assert property (@(posedge clk) bus_irq == (irq_ena && irq_sts));
a_bus_irq_needs_ena: assert property (@(posedge clk) bus_irq |-> irq_ena);
a_owr_p_def: assert property (@(posedge clk) owr_p == owr_pwr);
a_owr_e_def: assert property (@(posedge clk) owr_e == (owr_oen << owr_sel));
a_owr_e_onehot0: assert property (@(posedge clk) $onehot0(owr_e));
a_owr_iln_def: assert property (@(posedge clk) owr_iln == owr_i[owr_sel]);
a_pls_def: assert property (@(posedge clk) pls == (div == (owr_ovd ? cdr_o : cdr_n)));
a_req_ovd_def: assert property (@(posedge clk) req_ovd == (OVD_E ? (bus_wen_ctl_sts && bus_wdt[2]) : 1'b0));
a_no_ovd_when_disabled: assert property (@(posedge clk) disable iff (rst) (OVD_E == 0) |-> !owr_ovd);
a_dec_ren_ctl_sts: assert property (@(posedge clk) bus_ren_ctl_sts == (bus_ren && (bus_adr[0] == 1'b0)));
a_dec_wen_ctl_sts: assert property (@(posedge clk) bus_wen_ctl_sts == (bus_wen && (bus_adr[0] == 1'b0)));
a_dec_wen_pwr_sel: assert property (@(posedge clk) bus_wen_pwr_sel == (bus_wen && (bus_adr[0] == 1'b0)));
a_dec_wen_cdr_n: assert property (@(posedge clk) bus_wen_cdr_n == (bus_wen && (bus_adr[0] == 1'b1)));
a_dec_wen_cdr_o: assert property (@(posedge clk) bus_wen_cdr_o == (bus_wen && (bus_adr[0] == 1'b1)));
a_dec_wen_exclusive: assert property (@(posedge clk) !(bus_wen_ctl_sts && bus_wen_cdr_n));
a_rdt_ctl_sts_layout: assert property (@(posedge clk) bus_rdt_ctl_sts == {irq_ena, irq_sts, 1'b0, owr_pwr[0], owr_cyc, owr_ovd, owr_rst, owr_dat});
a_rdt_addr0: assert property (@(posedge clk) (bus_adr[0] == 1'b0) |-> bus_rdt == {bus_rdt_pwr_sel, bus_rdt_ctl_sts});
a_rdt_addr1: assert property (@(posedge clk) (bus_adr[0] == 1'b1) |-> bus_rdt == ((cdr_o << 16) | cdr_n));
a_rdt_addr0_bit5_zero: assert property (@(posedge clk) (bus_adr[0] == 1'b0) |-> bus_rdt[5] == 1'b0);
a_rdt_addr0_upper_zero_own1: assert property (@(posedge clk) ((OWN == 1) && (bus_adr[0] == 1'b0)) |-> bus_rdt[31:8] == '0);
a_cdr_n_write: assert property (@(posedge clk) disable iff (rst) (CDR_E && bus_wen_cdr_n) |=> cdr_n == $past(bus_wdt[15:0]));
a_cdr_o_write: assert property (@(posedge clk) disable iff (rst) (CDR_E && bus_wen_cdr_o) |=> cdr_o == $past(bus_wdt[31:16]));
a_cdr_n_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_cdr_n |=> $stable(cdr_n));
a_cdr_o_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_cdr_o |=> $stable(cdr_o));
a_div_clr_on_wen: assert property (@(posedge clk) disable iff (rst) bus_wen |=> div == '0);
a_div_clr_on_pls: assert property (@(posedge clk) disable iff (rst) (!bus_wen && pls) |=> div == '0);
a_div_inc: assert property (@(posedge clk) disable iff (rst) (!bus_wen && !pls && owr_cyc) |=> div == $past(div) + 1'b1);
a_div_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen && !pls && !owr_cyc) |=> $stable(div));
a_div_bounded: assert property (@(posedge clk) disable iff (rst) div <= (owr_ovd ? cdr_o : cdr_n));
a_div_zero_when_idle: assert property (@(posedge clk) disable iff (rst) !owr_cyc |-> div == '0);
a_irq_ena_write: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> irq_ena == $past(bus_wdt[7]));
a_irq_ena_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_ctl_sts |=> $stable(irq_ena));
a_irq_sts_clr_on_write: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> !irq_sts);
a_irq_sts_set_on_end: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && (cnt == t_zero)) |=> irq_sts);
a_irq_sts_clr_on_read: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !(pls && (cnt == t_zero)) && bus_ren_ctl_sts) |=> !irq_sts);
a_irq_sts_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !(pls && (cnt == t_zero)) && !bus_ren_ctl_sts) |=> $stable(irq_sts));
a_irq_sts_rise_cause: assert property (@(posedge clk) disable iff (rst) $rose(irq_sts) |-> $past(!bus_wen_ctl_sts && pls && (cnt == t_zero)));
a_owr_ovd_write: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_ovd == $past(req_ovd));
a_owr_ovd_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_ctl_sts |=> $stable(owr_ovd));
a_owr_rst_write: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_rst == $past(bus_wdt[1]));
a_owr_rst_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_ctl_sts |=> $stable(owr_rst));
a_owr_pwr_write_own1: assert property (@(posedge clk) disable iff (rst) ((OWN == 1) && bus_wen_ctl_sts) |=> owr_pwr[0] == $past(bus_wdt[4]));
a_owr_pwr_hold_own1: assert property (@(posedge clk) disable iff (rst) ((OWN == 1) && !bus_wen_ctl_sts) |=> $stable(owr_pwr));
a_owr_dat_write: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_dat == $past(bus_wdt[0]));
a_owr_dat_sample: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && (cnt == t_zero)) |=> owr_dat == $past(owr_smp));
a_owr_dat_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !(pls && (cnt == t_zero))) |=> $stable(owr_dat));
a_owr_cyc_write: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_cyc == $past(bus_wdt[3] && !(&bus_wdt[2:0])));
a_owr_cyc_no_start_all_ones: assert property (@(posedge clk) disable iff (rst) (bus_wen_ctl_sts && (&bus_wdt[2:0])) |=> !owr_cyc);
a_owr_cyc_end: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && (cnt == t_zero)) |=> !owr_cyc);
a_owr_cyc_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !(pls && (cnt == t_zero))) |=> $stable(owr_cyc));
a_owr_cyc_rise_cause: assert property (@(posedge clk) disable iff (rst) $rose(owr_cyc) |-> $past(bus_wen_ctl_sts && bus_wdt[3]));
a_cnt_load: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> cnt == $past(TDW'((&bus_wdt[1:0] ? t_idl : bus_wdt[1] ? t_rst : t_bit) - 1'b1)));
a_cnt_dec: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls) |=> cnt == $past(TDW'(cnt - 1'b1)));
a_cnt_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !pls) |=> $stable(cnt));
a_owr_smp_presence: assert property (@(posedge clk) disable iff (rst) (pls && owr_rst && (cnt == t_rstp)) |=> owr_smp == $past(owr_iln));
a_owr_smp_data: assert property (@(posedge clk) disable iff (rst) (pls && !owr_rst && (cnt == t_bits)) |=> owr_smp == $past(owr_iln));
a_owr_smp_hold: assert property (@(posedge clk) disable iff (rst) !(pls && (owr_rst ? (cnt == t_rstp) : (cnt == t_bits))) |=> $stable(owr_smp));
a_owr_oen_write: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_oen == $past(!(&bus_wdt[1:0])));
a_owr_oen_rel_rst: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && owr_rst && (cnt == t_rsth)) |=> !owr_oen);
a_owr_oen_rel_dat1: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && !(owr_rst && (cnt == t_rsth)) && owr_dat && (cnt == t_dat1)) |=> !owr_oen);
a_owr_oen_rel_dat0: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && (cnt == t_dat0)) |=> !owr_oen);
a_owr_oen_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !(pls && ((owr_rst && (cnt == t_rsth)) || (owr_dat && (cnt == t_dat1)) || (cnt == t_dat0)))) |=> $stable(owr_oen));
a_owr_oen_rise_cause: assert property (@(posedge clk) disable iff (rst) $rose(owr_oen) |-> $past(bus_wen_ctl_sts));
a_owr_oen_idle_write: assert property (@(posedge clk) disable iff (rst) (bus_wen_ctl_sts && (&bus_wdt[1:0])) |=> !owr_oen);
