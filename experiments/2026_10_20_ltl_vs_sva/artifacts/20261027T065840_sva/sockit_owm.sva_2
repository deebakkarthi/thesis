a_rst_div: assert property (@(posedge clk) rst |-> div == '0);
a_rst_cdr_n: assert property (@(posedge clk) rst |-> cdr_n == CDW'(CDR_N));
a_rst_cdr_o: assert property (@(posedge clk) rst |-> cdr_o == CDW'(CDR_O));
a_rst_pwr: assert property (@(posedge clk) rst |-> owr_pwr == '0);
a_rst_irq_ena: assert property (@(posedge clk) rst |-> !irq_ena);
a_rst_irq_sts: assert property (@(posedge clk) rst |-> !irq_sts);
a_rst_ovd: assert property (@(posedge clk) rst |-> !owr_ovd);
a_rst_rst: assert property (@(posedge clk) rst |-> !owr_rst);
a_rst_dat: assert property (@(posedge clk) rst |-> !owr_dat);
a_rst_cyc: assert property (@(posedge clk) rst |-> !owr_cyc);
a_rst_cnt: assert property (@(posedge clk) rst |-> cnt == '0);
a_rst_oen: assert property (@(posedge clk) rst |-> !owr_oen);
a_irq_out: assert property (@(posedge clk) bus_irq == (irq_ena & irq_sts));
a_owr_p: assert property (@(posedge clk) owr_p == owr_pwr);
a_owr_e: assert property (@(posedge clk) owr_e == (owr_oen << owr_sel));
a_owr_iln: assert property (@(posedge clk) owr_iln == owr_i[owr_sel]);
a_owr_sel_zero: assert property (@(posedge clk) (OWN == 1) |-> owr_sel == '0);
a_pls_def: assert property (@(posedge clk) pls == (div == (owr_ovd ? cdr_o : cdr_n)));
a_req_ovd: assert property (@(posedge clk) req_ovd == (OVD_E ? (bus_wen_ctl_sts & bus_wdt[2]) : 1'b0));
a_t_rsth: assert property (@(posedge clk) t_rsth == TDW'(owr_ovd ? T_RSTH_O : T_RSTH_N));
a_t_rstp: assert property (@(posedge clk) t_rstp == TDW'(owr_ovd ? T_RSTH_O - T_RSTP_O : T_RSTH_N - T_RSTP_N));
a_t_dat0: assert property (@(posedge clk) t_dat0 == TDW'(owr_ovd ? T_RCVR_O : T_RCVR_N));
a_t_dat1: assert property (@(posedge clk) t_dat1 == TDW'(owr_ovd ? T_DAT0_O - T_DAT1_O + T_RCVR_O : T_DAT0_N - T_DAT1_N + T_RCVR_N));
a_t_bits: assert property (@(posedge clk) t_bits == TDW'(owr_ovd ? T_DAT0_O - T_BITS_O + T_RCVR_O : T_DAT0_N - T_BITS_N + T_RCVR_N));
a_dec_ren_ctl: assert property (@(posedge clk) bus_ren_ctl_sts == (bus_ren && bus_adr[0] == 1'b0));
a_dec_wen_ctl: assert property (@(posedge clk) bus_wen_ctl_sts == (bus_wen && bus_adr[0] == 1'b0));
a_dec_wen_pwr: assert property (@(posedge clk) bus_wen_pwr_sel == (bus_wen && bus_adr[0] == 1'b0));
a_dec_wen_cdr_n: assert property (@(posedge clk) bus_wen_cdr_n == (bus_wen && bus_adr[0] == 1'b1));
a_dec_wen_cdr_o: assert property (@(posedge clk) bus_wen_cdr_o == (bus_wen && bus_adr[0] == 1'b1));
a_dec_excl: assert property (@(posedge clk) !(bus_wen_ctl_sts && bus_wen_cdr_n));
a_rdt_ctl_sts: assert property (@(posedge clk) bus_rdt_ctl_sts == {irq_ena, irq_sts, 1'b0, owr_pwr[0], owr_cyc, owr_ovd, owr_rst, owr_dat});
a_rdt_adr0: assert property (@(posedge clk) (bus_adr[0] == 1'b0) |-> bus_rdt == {bus_rdt_pwr_sel, bus_rdt_ctl_sts});
a_rdt_adr1: assert property (@(posedge clk) (bus_adr[0] == 1'b1) |-> bus_rdt == ((cdr_o << 16) | cdr_n));
a_rdt_bit5_zero: assert property (@(posedge clk) (bus_adr[0] == 1'b0) |-> bus_rdt[5] == 1'b0);
a_rdt_pwr_sel_zero: assert property (@(posedge clk) (OWN == 1) |-> bus_rdt_pwr_sel == '0);
a_cdr_n_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_cdr_n |=> cdr_n == $past(bus_wdt[15:0]));
a_cdr_o_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_cdr_o |=> cdr_o == $past(bus_wdt[31:16]));
a_cdr_n_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_cdr_n |=> $stable(cdr_n));
a_cdr_o_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_cdr_o |=> $stable(cdr_o));
a_div_wen_clr: assert property (@(posedge clk) disable iff (rst) bus_wen |=> div == '0);
a_div_pls_clr: assert property (@(posedge clk) disable iff (rst) (!bus_wen && pls) |=> div == '0);
a_div_inc: assert property (@(posedge clk) disable iff (rst) (!bus_wen && !pls) |=> div == CDW'($past(div) + $past(owr_cyc)));
a_div_idle_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen && !pls && !owr_cyc) |=> $stable(div));
a_pwr_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_pwr[0] == $past(bus_wdt[4]));
a_pwr_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_ctl_sts |=> $stable(owr_pwr));
a_irq_ena_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> irq_ena == $past(bus_wdt[7]));
a_irq_ena_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_ctl_sts |=> $stable(irq_ena));
a_irq_sts_wr_clr: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> !irq_sts);
a_irq_sts_set: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && cnt == '0) |=> irq_sts);
a_irq_sts_rd_clr: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !(pls && cnt == '0) && bus_ren_ctl_sts) |=> !irq_sts);
a_irq_sts_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !(pls && cnt == '0) && !bus_ren_ctl_sts) |=> $stable(irq_sts));
a_irq_sts_rose: assert property (@(posedge clk) disable iff (rst) $rose(irq_sts) |-> $past(!bus_wen_ctl_sts && pls && cnt == '0));
a_ovd_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_ovd == $past(req_ovd));
a_ovd_wr_data: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_ovd == (OVD_E ? $past(bus_wdt[2]) : 1'b0));
a_ovd_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_ctl_sts |=> $stable(owr_ovd));
a_ovd_disabled: assert property (@(posedge clk) (OVD_E == 0) |-> !owr_ovd);
a_rst_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_rst == $past(bus_wdt[1]));
a_rst_hold: assert property (@(posedge clk) disable iff (rst) !bus_wen_ctl_sts |=> $stable(owr_rst));
a_dat_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_dat == $past(bus_wdt[0]));
a_dat_end: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && cnt == '0) |=> owr_dat === $past(owr_smp));
a_dat_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !(pls && cnt == '0)) |=> $stable(owr_dat));
a_cyc_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_cyc == $past(bus_wdt[3] & ~&bus_wdt[2:0]));
a_cyc_end: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && cnt == '0) |=> !owr_cyc);
a_cyc_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !(pls && cnt == '0)) |=> $stable(owr_cyc));
a_cyc_idle_stays: assert property (@(posedge clk) disable iff (rst) (!owr_cyc && !bus_wen_ctl_sts) |=> !owr_cyc);
a_cyc_rose: assert property (@(posedge clk) disable iff (rst) $rose(owr_cyc) |-> $past(bus_wen_ctl_sts && bus_wdt[3] && !(&bus_wdt[2:0])));
a_cnt_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> cnt == TDW'($past((&bus_wdt[1:0] ? t_idl : bus_wdt[1] ? t_rst : t_bit) - 'd1)));
a_cnt_dec: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls) |=> cnt == TDW'($past(cnt) - 'd1));
a_cnt_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !pls) |=> $stable(cnt));
a_oen_wr: assert property (@(posedge clk) disable iff (rst) bus_wen_ctl_sts |=> owr_oen == $past(~&bus_wdt[1:0]));
a_oen_release: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && ((owr_rst && cnt == t_rsth) || (owr_dat && cnt == t_dat1) || (cnt == t_dat0))) |=> !owr_oen);
a_oen_hold_pls: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && pls && !((owr_rst && cnt == t_rsth) || (owr_dat && cnt == t_dat1) || (cnt == t_dat0))) |=> $stable(owr_oen));
a_oen_hold: assert property (@(posedge clk) disable iff (rst) (!bus_wen_ctl_sts && !pls) |=> $stable(owr_oen));
a_oen_rose: assert property (@(posedge clk) disable iff (rst) $rose(owr_oen) |-> $past(bus_wen_ctl_sts && !(&bus_wdt[1:0])));
a_smp_presence: assert property (@(posedge clk) (pls && owr_rst && cnt == t_rstp) |=> owr_smp === $past(owr_iln));
a_smp_data: assert property (@(posedge clk) (pls && !owr_rst && cnt == t_bits) |=> owr_smp === $past(owr_iln));
a_smp_hold: assert property (@(posedge clk) !(pls && ((owr_rst && cnt == t_rstp) || (!owr_rst && cnt == t_bits))) |=> owr_smp === $past(owr_smp));
