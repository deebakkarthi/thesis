a_rst_owr_p_clear: assert property (@(posedge clk) $fell(rst) |-> owr_p == '0);
a_rst_owr_e_clear: assert property (@(posedge clk) $fell(rst) |-> owr_e == '0);
a_rst_irq_clear: assert property (@(posedge clk) $fell(rst) |-> !bus_irq);
a_rst_cdr_default: assert property (@(posedge clk) disable iff (rst) $fell(rst) ##0 (!(bus_wen && bus_adr == 1))[*0:$] ##1 (bus_ren && bus_adr == 1) |-> bus_rdt == {CDR_O[15:0], CDR_N[15:0]});
a_outputs_known: assert property (@(posedge clk) disable iff (rst) !$isunknown({bus_irq, owr_e, owr_p}));
a_rdt_known_on_read: assert property (@(posedge clk) disable iff (rst) bus_ren |-> !$isunknown(bus_rdt));
a_owr_e_onehot0: assert property (@(posedge clk) disable iff (rst) $onehot0(owr_e));
a_owr_e_not_on_powered_line: assert property (@(posedge clk) disable iff (rst) (owr_e & owr_p) == '0);
a_owr_e_only_selected_line: assert property (@(posedge clk) disable iff (rst) (OWN > 1) && bus_ren && bus_adr == 0 && owr_e != '0 |-> owr_e == (1 << bus_rdt[11:8]));
a_owr_e_idle_when_no_cycle: assert property (@(posedge clk) disable iff (rst) bus_ren && bus_adr == 0 && !bus_rdt[3] |-> owr_e == '0);
a_owr_e_rise_only_after_write: assert property (@(posedge clk) disable iff (rst) $rose(|owr_e) |-> $past(bus_wen && bus_adr == 0 && bus_wdt[3]));
a_owr_e_single_pulse_per_cycle: assert property (@(posedge clk) disable iff (rst) $fell(|owr_e) |-> (owr_e == '0) until (bus_wen && bus_adr == 0));
a_data_reset_cycle_drives_line: assert property (@(posedge clk) disable iff (rst) bus_wen && bus_adr == 0 && bus_wdt[3] && !(bus_wdt[1] && bus_wdt[0]) && ((OWN == 1) ? !bus_wdt[4] : !bus_wdt[16 + bus_wdt[11:8]]) |=> owr_e != '0);
a_idle_cycle_no_drive: assert property (@(posedge clk) disable iff (rst) bus_wen && bus_adr == 0 && bus_wdt[3] && bus_wdt[1] && bus_wdt[0] |=> (owr_e == '0) until (bus_wen && bus_adr == 0));
a_no_cycle_no_drive: assert property (@(posedge clk) disable iff (rst) bus_wen && bus_adr == 0 && !bus_wdt[3] |=> owr_e == '0);
a_cyc_status_after_start: assert property (@(posedge clk) disable iff (rst) bus_wen && bus_adr == 0 && bus_wdt[3] && !(bus_wdt[2] && bus_wdt[1] && bus_wdt[0]) ##1 (bus_ren && bus_adr == 0) |-> bus_rdt[3]);
a_ien_readback: assert property (@(posedge clk) disable iff (rst) bus_wen && bus_adr == 0 ##1 (bus_ren && bus_adr == 0) |-> bus_rdt[7] == $past(bus_wdt[7]));
a_rst_bit_readback: assert property (@(posedge clk) disable iff (rst) bus_wen && bus_adr == 0 ##1 (bus_ren && bus_adr == 0) |-> bus_rdt[1] == $past(bus_wdt[1]));
a_ovd_readback: assert property (@(posedge clk) disable iff (rst) (OVD_E == 1) && bus_wen && bus_adr == 0 ##1 (bus_ren && bus_adr == 0) |-> bus_rdt[2] == $past(bus_wdt[2]));
a_select_readback: assert property (@(posedge clk) disable iff (rst) (OWN > 1) && bus_wen && bus_adr == 0 ##1 (bus_ren && bus_adr == 0) |-> bus_rdt[8 +: $clog2(OWN)] == $past(bus_wdt[8 +: $clog2(OWN)]));
a_power_reg_to_owr_p: assert property (@(posedge clk) disable iff (rst) (OWN > 1) && bus_wen && bus_adr == 0 |=> owr_p == $past(bus_wdt[16 +: OWN]));
a_pwr_bit_to_owr_p: assert property (@(posedge clk) disable iff (rst) (OWN == 1) && bus_wen && bus_adr == 0 |=> owr_p[0] == $past(bus_wdt[4]));
a_owr_p_stable_without_write: assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr == 0) |=> $stable(owr_p));
a_power_readback: assert property (@(posedge clk) disable iff (rst) (OWN > 1) && bus_ren && bus_adr == 0 |-> bus_rdt[16 +: OWN] == owr_p);
a_pwr_read_selected_line: assert property (@(posedge clk) disable iff (rst) bus_ren && bus_adr == 0 |-> bus_rdt[4] == ((OWN == 1) ? owr_p[0] : owr_p[bus_rdt[11:8]]));
a_irq_out_is_irq_and_ien: assert property (@(posedge clk) disable iff (rst) bus_ren && bus_adr == 0 |-> bus_irq == (bus_rdt[6] && bus_rdt[7]));
a_irq_cleared_by_read: assert property (@(posedge clk) disable iff (rst) bus_irq && bus_ren && bus_adr == 0 |=> !bus_irq);
a_irq_masked_by_ien: assert property (@(posedge clk) disable iff (rst) bus_wen && bus_adr == 0 && !bus_wdt[7] |=> !bus_irq);
a_irq_rise_at_cycle_end: assert property (@(posedge clk) disable iff (rst) $rose(bus_irq) |-> owr_e == '0);
a_irq_eventually_after_cycle: assert property (@(posedge clk) disable iff (rst) bus_wen && bus_adr == 0 && bus_wdt[3] && bus_wdt[7] |=> s_eventually (bus_irq || bus_wen));
a_cdr_const_when_disabled: assert property (@(posedge clk) disable iff (rst) (CDR_E == 0) && bus_ren && bus_adr == 1 |-> bus_rdt == {CDR_O[15:0], CDR_N[15:0]});
a_cdr_write_readback: assert property (@(posedge clk) disable iff (rst) (CDR_E == 1) && bus_wen && bus_adr == 1 ##1 (bus_ren && bus_adr == 1) |-> bus_rdt == $past(bus_wdt));
