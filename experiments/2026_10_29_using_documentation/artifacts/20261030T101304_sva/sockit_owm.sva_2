a_rst_outputs_idle: assert property (@(posedge clk) $past(rst) |-> (owr_e == '0) && (owr_p == '0) && !bus_irq);
a_rst_ctl_value: assert property (@(posedge clk) disable iff (rst) $past(rst) && bus_ren && (bus_adr == 0) |-> (bus_rdt[7] == 1'b0) && (bus_rdt[6] == 1'b0) && (bus_rdt[4:1] == 4'b0000));
a_rst_select_value: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && (OWN > 1) && $past(rst) && bus_ren && (bus_adr == 0) |-> (bus_rdt[11:8] == 4'd0));
a_rst_power_value: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && (OWN > 1) && $past(rst) && bus_ren && (bus_adr == 0) |-> (bus_rdt[31:16] == 16'd0));
a_rst_cdr_value: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && $past(rst) && bus_ren && (bus_adr == 1) |-> (bus_rdt == {CDR_O[15:0], CDR_N[15:0]}));
a_cdr_const_when_disabled: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && (CDR_E == 0) && bus_ren && (bus_adr == 1) |-> (bus_rdt == {CDR_O[15:0], CDR_N[15:0]}));
a_cdr_write_readback: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && (CDR_E == 1) && bus_wen && (bus_adr == 1) |=> (bus_ren && (bus_adr == 1)) -> (bus_rdt == $past(bus_wdt)));
a_cdr_stable_without_write: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && bus_ren && (bus_adr == 1) && $past(bus_ren && (bus_adr == 1)) && !$past(bus_wen && (bus_adr == 1)) |-> $stable(bus_rdt));
a_single_line_active: assert property (@(posedge clk) disable iff (rst) $onehot0(owr_e));
a_no_drive_on_powered_line: assert property (@(posedge clk) disable iff (rst) (owr_e & owr_p) == '0);
a_irq_is_irq_and_ien: assert property (@(posedge clk) disable iff (rst) bus_ren && (bus_adr == 0) |-> (bus_irq == (bus_rdt[6] && bus_rdt[7])));
a_irq_requires_ien: assert property (@(posedge clk) disable iff (rst) bus_ren && (bus_adr == 0) && !bus_rdt[7] |-> !bus_irq);
a_irq_cleared_by_read: assert property (@(posedge clk) disable iff (rst) bus_ren && (bus_adr == 0) |=> !bus_irq);
a_irq_ctl_cleared_by_read: assert property (@(posedge clk) disable iff (rst) bus_ren && (bus_adr == 0) ##1 bus_ren && (bus_adr == 0) |-> !bus_rdt[6]);
a_no_cycle_no_drive: assert property (@(posedge clk) disable iff (rst) bus_ren && (bus_adr == 0) && !bus_rdt[3] |-> (owr_e == '0));
a_cyc_set_after_start: assert property (@(posedge clk) disable iff (rst) bus_wen && (bus_adr == 0) && bus_wdt[3] && !(bus_wdt[1] && bus_wdt[0] && bus_wdt[2] && (OVD_E == 1)) |=> (bus_ren && (bus_adr == 0)) -> bus_rdt[3]);
a_data_cycle_drives_selected_line: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && bus_wen && (bus_adr == 0) && bus_wdt[3] && !bus_wdt[1] && ((OWN == 1) || (bus_wdt[11:8] < OWN)) && !((OWN == 1) ? bus_wdt[4] : bus_wdt[16 + bus_wdt[11:8]]) |=> owr_e[(OWN == 1) ? 0 : $past(bus_wdt[11:8])] && $onehot(owr_e));
a_reset_cycle_drives_selected_line: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && bus_wen && (bus_adr == 0) && bus_wdt[3] && bus_wdt[1] && !bus_wdt[0] && ((OWN == 1) || (bus_wdt[11:8] < OWN)) && !((OWN == 1) ? bus_wdt[4] : bus_wdt[16 + bus_wdt[11:8]]) |=> owr_e[(OWN == 1) ? 0 : $past(bus_wdt[11:8])] && $onehot(owr_e));
a_idle_cycle_no_drive: assert property (@(posedge clk) disable iff (rst) bus_wen && (bus_adr == 0) && bus_wdt[3] && bus_wdt[1] && bus_wdt[0] |=> (owr_e == '0));
a_no_start_no_drive: assert property (@(posedge clk) disable iff (rst) bus_wen && (bus_adr == 0) && !bus_wdt[3] && (owr_e == '0) |=> (owr_e == '0));
a_power_multi_line: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && (OWN > 1) && bus_wen && (bus_adr == 0) |=> (owr_p == $past(bus_wdt[16 +: OWN])));
a_power_single_line: assert property (@(posedge clk) disable iff (rst) (OWN == 1) && bus_wen && (bus_adr == 0) |=> (owr_p[0] == $past(bus_wdt[4])));
a_power_stable_without_write: assert property (@(posedge clk) disable iff (rst) !(bus_wen && (bus_adr == 0)) |=> $stable(owr_p));
a_pwr_read_selected_line: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && bus_ren && (bus_adr == 0) && ((OWN == 1) || (bus_rdt[11:8] < OWN)) |-> (bus_rdt[4] == owr_p[(OWN == 1) ? 0 : bus_rdt[11:8]]));
a_select_readback: assert property (@(posedge clk) disable iff (rst) (BDW == 32) && (OWN > 1) && bus_wen && (bus_adr == 0) |=> (bus_ren && (bus_adr == 0)) -> (bus_rdt[11:8] == $past(bus_wdt[11:8])));
a_ien_readback: assert property (@(posedge clk) disable iff (rst) bus_wen && (bus_adr == 0) |=> (bus_ren && (bus_adr == 0)) -> (bus_rdt[7] == $past(bus_wdt[7])));
a_ovd_rst_readback: assert property (@(posedge clk) disable iff (rst) (OVD_E == 1) && bus_wen && (bus_adr == 0) |=> (bus_ren && (bus_adr == 0)) -> (bus_rdt[2:1] == $past(bus_wdt[2:1])));
