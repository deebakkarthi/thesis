!ien & !irq & !cyc & !ovd & !rst & !pwr & "select==0" & "power==0" & "owr_p==0"
G !(bus_wen & bus_ren)
G (bus_irq <-> (ien & irq))
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]") -> X cyc)
G ((!cyc & X cyc) -> (bus_wen & "bus_adr==0" & "bus_wdt[3]"))
G ((!cyc & !(bus_wen & "bus_adr==0" & "bus_wdt[3]")) -> X !cyc)
