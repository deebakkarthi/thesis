G ((cyc & X !cyc) -> X irq)
G ((!irq & X irq) -> (cyc & X !cyc))
G ((irq & !(bus_ren & "bus_adr==0")) -> X irq)
G ((bus_ren & "bus_adr==0" & !cyc) -> X !irq)
G (owr_e -> cyc)
G ("owr_e[0]" -> "select==0")
G ("owr_e[1]" -> "select==1")
G !("owr_p[0]" & "owr_e[0]")
G !("owr_p[1]" & "owr_e[1]")
G ((bus_wen & "bus_adr==1") -> !cyc)
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]" & !"bus_wdt[1]") -> X (cyc & owr_e))
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]" & "bus_wdt[1]" & !"bus_wdt[0]") -> X (cyc & owr_e))
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]" & "bus_wdt[1]" & "bus_wdt[0]") -> X (!owr_e W (!cyc | bus_wen)))
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]" & !"bus_wdt[1]" & !"bus_wdt[0]") -> X ((owr_e U (cyc & !owr_e)) | (owr_e U bus_wen)))
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]" & !"bus_wdt[1]" & "bus_wdt[0]") -> X ((owr_e U (cyc & !owr_e)) | (owr_e U bus_wen)))
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]" & "bus_wdt[1]" & !"bus_wdt[0]") -> X ((owr_e U (cyc & !owr_e)) | (owr_e U bus_wen)))
G ((cyc & !owr_e & !bus_wen) -> X !owr_e)
