!cyc & !irq & !ien & !ovd & !rst & !pwr & "select==0" & "power==0"
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]") -> X cyc)
G ((!cyc & X cyc) -> (bus_wen & "bus_adr==0" & "bus_wdt[3]"))
G ((bus_wen & "bus_adr==0") -> ((X ien) <-> "bus_wdt[7]"))
G ((bus_wen & "bus_adr==0") -> ((X ovd) <-> "bus_wdt[2]"))
G ((bus_wen & "bus_adr==0") -> ((X rst) <-> "bus_wdt[1]"))
G (!(bus_wen & "bus_adr==0") -> ((ien <-> X ien) & (ovd <-> X ovd) & (rst <-> X rst)))
G ((!cyc & !(bus_wen & "bus_adr==0")) -> (dat <-> X dat))
G (cyc -> F (!cyc | (bus_wen & "bus_adr==0" & "bus_wdt[3]")))
G ((cyc & X !cyc & !(X (bus_wen & "bus_adr==0"))) -> X irq)
G ((!irq & X irq) -> (cyc & X !cyc))
G ((irq & !(bus_ren & "bus_adr==0")) -> X irq)
G ((bus_ren & "bus_adr==0" & !cyc) -> X !irq)
G (bus_irq <-> (irq & ien))
G (!ien -> !bus_irq)
G ((cyc & ien) -> F (bus_irq | !ien | (bus_wen & "bus_adr==0")))
G ((bus_ren & "bus_adr==0") -> ("bus_rdt[3]" <-> cyc))
G ((bus_ren & "bus_adr==0") -> ("bus_rdt[6]" <-> irq))
G ((bus_ren & "bus_adr==0") -> ("bus_rdt[7]" <-> ien))
G ((bus_ren & "bus_adr==0") -> ("bus_rdt[2]" <-> ovd))
G ((bus_ren & "bus_adr==0") -> ("bus_rdt[1]" <-> rst))
G ("owr_e!=0" -> cyc)
G (!cyc -> "owr_e==0")
G ("$onehot0(owr_e)")
G (!"select==0" -> !"owr_e[0]")
G (!"select==1" -> !"owr_e[1]")
G ("owr_p[0]" -> !"owr_e[0]")
G ("owr_p[1]" -> !"owr_e[1]")
G ("OWN==1" -> ("owr_p[0]" <-> pwr))
G ("OWN>1" -> "owr_p==power[OWN-1:0]")
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]" & !("bus_wdt[1]" & "bus_wdt[0]") & "power[bus_wdt[11:8]]==0") -> X "owr_e!=0")
G ((bus_wen & "bus_adr==0" & "bus_wdt[3]" & "bus_wdt[1]" & "bus_wdt[0]") -> X ("owr_e==0" W (!cyc | (bus_wen & "bus_adr==0"))))
G ("OVD_E==0" -> !ovd)
G ("CDR_E==0" -> ("cdr_n==CDR_N" & "cdr_o==CDR_O"))
G ((!"CDR_E==0" & bus_wen & "bus_adr==1" & !cyc) -> X ("cdr_n==$past(bus_wdt[15:0])" & "cdr_o==$past(bus_wdt[31:16])"))
